{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hariboweb-game",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public" },
  // 워커를 D1 데이터베이스(APAC) 가까이에서 실행해서, 화면 하나에 DB를 여러 번 읽어도 빨라요.
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "haribo-dogam",
      "database_id": "607d6192-35d0-435b-90cc-16fdee9abc10",
      "migrations_dir": "migrations"
    }
  ],
  // 광장(같이 돌아다니는 지도) 실시간 연결. 무료 요금제는 SQLite 방식만 쓸 수 있어요.
  // Workers AI(무료 사용량): 같이 배정되지 않기 사유 검토
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "PLAZA", "class_name": "PlazaRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlazaRoom"] }],
  "vars": {
    // 디스코드 개발자 포털의 봇 애플리케이션 ID
    "DISCORD_CLIENT_ID": "1420027662830669925",
    // 하리보 서버 ID
    "GUILD_ID": "1261363193519935550",
    // 배포된 주소 (예: https://hariboweb-game.<계정>.workers.dev)
    "PUBLIC_URL": "https://hariboweb-game.haribobot.workers.dev"
  }
  // 비밀 값은 `npx wrangler secret put 이름`으로 넣어요:
  //   DISCORD_CLIENT_SECRET, SESSION_SECRET, BOT_SYNC_SECRET
}
