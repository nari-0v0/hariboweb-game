{
  "name": "hariboweb-game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply haribo-dogam --local",
    "db:migrate:remote": "wrangler d1 migrations apply haribo-dogam --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "playtest": "node scripts/playtest.mjs"
  },
  "dependencies": {
    "hono": "4.13.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "esbuild": "0.28.2",
    "playwright": "1.65.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.151.0"
  }
}
