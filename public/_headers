# 캐릭터 그림과 글꼴은 잘 안 바뀌어서 브라우저에 오래 두고 다시 받지 않아요(화면 옮길 때 빨라져요).
/char/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# 화면 꾸밈 파일은 배포 때 바뀌니 짧게 두고, 그 사이에는 갖고 있던 걸 먼저 보여 주며 뒤에서 새로 받아요.
/styles.css
  Cache-Control: public, max-age=60, stale-while-revalidate=604800
/app.js
  Cache-Control: public, max-age=60, stale-while-revalidate=604800
# 원정대·사건파일 그림과 배경도 잘 안 바뀌어서 하루 동안 다시 묻지 않고 바로 써요.
/case/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/journey/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
# 화면 아이콘(알림 종 등)
/ui/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
# 겜블장 그림은 주소 끝 ?v=숫자를 바꿔서 새로 받게 하니, 브라우저에 오래 두고 다시 묻지 않아요.
/gamble/*
  Cache-Control: public, max-age=31536000, immutable
# 겜블장 스크립트도 주소 끝 ?v=숫자로 바꿔요. 매번 서버에 다시 묻지 않아야 결과 화면이 바로 움직여요.
/gamble.js
  Cache-Control: public, max-age=31536000, immutable
# 디스코드 액티비티 스크립트도 주소 끝 ?v=숫자로 바꿔요.
/discord-activity.js
  Cache-Control: public, max-age=31536000, immutable
